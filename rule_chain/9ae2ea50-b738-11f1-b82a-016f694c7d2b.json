      "configuration" : {
        "scriptLang" : "JS",
        "jsScript" : "var TZ_OFFSET_MIN = 330;\nif (metadata.calculatedFieldName == \"Calculate Plant Shift OEE\")\n{\n\n// Use incoming telemetry timestamp if available.\n// Otherwise use current time.\nvar now = msg.shift_start ? Number(msg.shift_start) : new Date().getTime();\n\n// Convert to IST\nvar localMs = now + TZ_OFFSET_MIN * 60000;\nvar localMidnight = localMs - (localMs % 86400000);\nvar hour = (localMs - localMidnight) / 3600000;\n\n// Determine shift\nvar shiftHour, shiftNo;\n\nif (hour < 8) {\n    shiftHour = 0;\n    shiftNo = 1;\n} else if (hour < 16) {\n    shiftHour = 8;\n    shiftNo = 2;\n} else {\n    shiftHour = 16;\n    shiftNo = 3;\n}\n\n// Shift start timestamp (UTC)\nvar shiftStartUtc = localMidnight + shiftHour * 3600000 - TZ_OFFSET_MIN * 60000;\n\n// Save this record at shift start\nmetadata.ts = String(shiftStartUtc);\n\n// Optional: store shift number\nmsg.values.shift_no = shiftNo;\nmsg.values.shift_start = shiftStartUtc;\nmsg.ts = shiftStartUtc;\n\n}\nelse if (metadata.calculatedFieldName == \"Calculated Day OEE\")\n{\n    var now = msg.ts ? Number(msg.ts) : new Date().getTime();\n// Convert to IST\nvar localMs = now + TZ_OFFSET_MIN * 60000;\n\n// Today's midnight in IST\nvar localMidnight = localMs - (localMs % 86400000);\n\n// Convert back to UTC timestamp\nvar dayStartUtc = localMidnight - TZ_OFFSET_MIN * 60000;\n\n\n// msg.values.shift_start = now;\nmsg.ts = dayStartUtc;\nmetadata.ts = dayStartUtc;\n}\nreturn { msg: msg, metadata: metadata, msgType: msgType };",
        "tbelScript" : "var TZ_OFFSET_MIN = 330;\n\n// Use incoming telemetry timestamp if available.\n// Otherwise use current time.\nvar now = msg.shift_start ? Number(msg.shift_start) : new Date().getTime();\n\n// Convert to IST\nvar localMs = now + TZ_OFFSET_MIN * 60000;\nvar localMidnight = localMs - (localMs % 86400000);\nvar hour = (localMs - localMidnight) / 3600000;\n\n// Determine shift\nvar shiftHour, shiftNo;\n\nif (hour < 8) {\n    shiftHour = 0;\n    shiftNo = 1;\n} else if (hour < 16) {\n    shiftHour = 8;\n    shiftNo = 2;\n} else {\n    shiftHour = 16;\n    shiftNo = 3;\n}\n\n// Shift start timestamp (UTC)\nvar shiftStartUtc = localMidnight + shiftHour * 3600000 - TZ_OFFSET_MIN * 60000;\n\n// Save this record at shift start\nmetadata.ts = String(shiftStartUtc);\n\n// Optional: store shift number\nmsg.shift_no = shiftNo;\nmsg.shift_start = shiftStartUtc;\n\nreturn { msg: msg, metadata: metadata, msgType: msgType };"
